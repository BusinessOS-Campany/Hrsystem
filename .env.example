# PostgreSQL connection string. Never commit real credentials.
DATABASE_URL="postgresql://username:password@localhost:5432/HRSYS?schema=public"

# 32+ random bytes used to sign/derive auth tokens. Generate with:
# openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-long-random-secret"

# Public URL of the application
APP_URL="http://localhost:3000"

# Optional: override the local seed admin password. The seed defaults to "admin"
# in development and to the shared demo password when NODE_ENV=production.
# ADMIN_PASSWORD="change-me"
